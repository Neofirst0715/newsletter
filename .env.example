# Copy this file to .env and fill in real values. .env is gitignored;
# this file (.env.example) is the one that gets committed.

# generate.py -- local Ollama model (both optional, shown defaults below)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# send.py -- Gmail SMTP (use a Gmail App Password, not your normal password)
SENDER_EMAIL=your-gmail-address@gmail.com
SENDER_APP_PASSWORD=your-gmail-app-password
RECIPIENT_EMAIL=recipient@example.com

# collect.py -- data source URLs
VOLTA_EVENTS_URL=https://voltaeffect.com/events
EVENTBRITE_HALIFAX_TECH_URL=https://www.eventbrite.com/d/canada--halifax/tech-startup/
